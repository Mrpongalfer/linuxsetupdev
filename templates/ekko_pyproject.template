[project]
name = "ekko-agent"
version = "0.1.0"
description = "Ekko: AI-Driven Development & Deployment Platform"
readme = "README.md"
requires-python = ">=3.11" # Changed 
license = { text = "MIT License" } # Use text field for MIT
authors = [ { name = "Architect Alix Feronti", email = "pongalfer@gmail.com" } ]
classifiers = [
    "Development Status :: 3 - Alpha", "Intended Audience :: Developers",
    "License :: OSI Approved :: MIT License", "Programming Language :: Python :: 3",
    "Programming Language :: Python :: 3.11", # Specify 3.11
    "Operating System :: OS Independent",
    "Topic :: Software Development :: Build Tools", "Topic :: Software Development :: Testing",
    "Topic :: Scientific/Engineering :: Artificial Intelligence",
]
# Core runtime dependencies - ensure compatibility with Py3.11
dependencies = [
    "fastapi>=0.110.0,<1.0.0", # Check latest compatible with 3.11 if issues arise
    "uvicorn[standard]>=0.29.0,<1.0.0",
    "textual>=0.58.0,<1.0.0",
    "pydantic>=2.7.0,<3.0.0",
    "pydantic-settings>=2.2.0,<3.0.0",
    "httpx>=0.27.0,<1.0.0",
    "paramiko>=3.4.0,<4.0.0",
    "cryptography>=42.0.0,<43.0.0",
    "bcrypt>=4.1.0,<5.0.0",
    "ansible-runner>=2.3.0,<3.0.0",
    "python-keyring>=25.0.0,<26.0.0", # Removed [cli] extra previously
    "structlog>=24.1.0,<25.0.0",
    "prometheus-client>=0.20.0,<1.0.0",
    "tomllib>=1.0.4,<2.0.0; python_version < '3.11'", # Keep for safety, though target is >=3.11
    "GitPython>=3.1.40,<4.0.0",
    "PyYAML>=6.0,<7.0"
    "psutil>=5.9.0,<6.0.0" # <-- ADD THIS LINE
]

[project.optional-dependencies]
dev = [
    "ruff>=0.4.4,<0.5.0",
    "pre-commit>=3.7.0,<4.0.0",
    "mypy>=1.9.0,<1.11.0",
    "pytest>=8.2.0,<9.0.0",
    "pytest-cov>=5.0.0,<6.0.0",
    "pytest-asyncio>=0.23.0,<0.24.0",
]

[project.scripts]
ekko = "ekko.cli.main:app"

[build-system]
requires = ["setuptools>=61.0"]
build-backend = "setuptools.build_meta"

[tool.setuptools.packages.find]
where = ["src"]

[tool.ruff]
line-length = 88
target-version = "py311" # Changed 

[tool.ruff.lint]
select = ["E","W","F","I","N","UP","B","C4","A","SIM","PTH","PL","TID","TCH","RUF","BLE","S"]
ignore = ["E501","B008","PLR0913","PLR2004","S101"]
dummy-variable-rgx = "^(_+|(_[a-zA-Z0-9_]*[a-zA-Z0-9]+?))$"
[tool.ruff.lint.per-file-ignores]
"src/ekko/cli/main.py" = ["T201"]; "src/ekko/tui/main.py" = ["T201"]
"src/ekko/main.py" = ["T201"]; "tests/**" = ["S101"]

[tool.ruff.format]
quote-style = "double"; indent-style = "space"; skip-magic-trailing-comma = false; line-ending = "lf"

[tool.mypy]
python_version = "3.11" # Changed 
warn_return_any = true; warn_unused_configs = true; ignore_missing_imports = true
files = ["src/ekko"]